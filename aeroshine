<section id="services-tiv">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="kicker" data-i18n="tiv_kicker">Station 01</span>
      <h2 data-i18n="tiv_title">Tivat Airport — TIV</h2>
      <p data-i18n="tiv_desc">Apron access arranged directly with your handling agent. All products are safe for composite fuselage, avionics and leather.</p>
    </div>

    <div class="station-head reveal">
      <span class="st-name" data-i18n="manifest_label">Service manifest</span>
      <span class="st-code mono" data-i18n="tiv_code">LYTV · STAND ACCESS BY ARRANGEMENT</span>
    </div>

    <div class="manifest reveal">
      <div class="row">
        <div class="code">EXT·01</div>
        <div class="info"><h3 data-i18n="row_ext_title">Exterior wash &amp; polish</h3><p data-i18n="row_ext_desc">Fuselage hand-wash, streak-free glass, engine cowling and gear bay wipe-down.</p></div>
        <div class="time" data-i18n="row_ext_time">≈ 90 min</div>
      </div>
      <div class="row">
        <div class="code">INT·02</div>
        <div class="info"><h3 data-i18n="row_int_title">Cabin &amp; leather detailing</h3><p data-i18n="row_int_desc">Deep clean of seats, carpets and cabinetry; leather conditioning and odour neutralising before boarding.</p></div>
        <div class="time" data-i18n="row_int_time">≈ 75 min</div>
      </div>
