<!DOCTYPE html>
<html lang="en" id="htmlRoot">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ME MONTENEGRO — Apron-Side Jet Detailing, Tivat &amp; Dubrovnik</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F1EEE6;
    --panel:#E8E3D7;
    --panel-2:#DFD9CA;
    --ink:#191A18;
    --ink-soft:#5B5C56;
    --ink-faint:#8B8C84;
    --line: rgba(25,26,24,0.14);
    --line-strong: rgba(25,26,24,0.28);
    --stamp:#7A3230;
    --stamp-soft: rgba(122,50,48,0.09);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter', sans-serif;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3{
    font-family:'Fraunces', serif;
    font-optical-sizing:auto;
    font-weight:600;
    letter-spacing:-0.01em;
    line-height:1.02;
  }
  .mono{ font-family:'IBM Plex Mono', monospace; }
  a{ color:inherit; text-decoration:none; }
  img{ max-width:100%; display:block; }
  .wrap{ max-width:1180px; margin:0 auto; padding:0 28px; }
  ::selection{ background:var(--stamp); color:var(--paper); }

  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:0.01ms !important; transition-duration:0.01ms !important; scroll-behavior:auto !important; }
  }

  .reveal{ opacity:0; transform:translateY(14px); transition:opacity .6s ease, transform .6s ease; }
  .reveal.in{ opacity:1; transform:translateY(0); }

  .photo-tone{
    filter:grayscale(0.55) contrast(1.06) brightness(0.98);
    transition:filter .5s ease;
  }
  .photo-tone:hover{ filter:grayscale(0) contrast(1.02) brightness(1); }

  /* ---------- top strip ---------- */
  .topstrip{
    background:var(--ink);
    color:var(--paper);
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    letter-spacing:0.05em;
  }
  .topstrip .wrap{
    display:flex; justify-content:space-between; align-items:center;
    padding-top:9px; padding-bottom:9px; gap:16px; flex-wrap:wrap;
  }
  .topstrip span{ white-space:nowrap; opacity:0.82; }
  .topstrip .dot{ color:#C98F8C; }

  /* ---------- nav ---------- */
  nav{
    position:sticky; top:0; z-index:50;
    background:rgba(241,238,230,0.92);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  nav .wrap{ display:flex; align-items:center; justify-content:space-between; height:74px; }
  .logo{ display:flex; align-items:center; gap:11px; }
  .logo .mark{ width:26px; height:26px; flex-shrink:0; }
  .logo .word{ display:flex; flex-direction:column; line-height:1; }
  .logo .m1{ font-family:'Fraunces'; font-weight:600; font-size:18px; letter-spacing:0; }
  .logo .m2{ font-family:'IBM Plex Mono'; font-size:9.5px; letter-spacing:0.14em; color:var(--ink-soft); margin-top:3px; text-transform:uppercase; }
  .navlinks{ display:flex; gap:30px; font-size:13.5px; letter-spacing:0.01em; }
  .navlinks a{ color:var(--ink-soft); transition:color .2s ease; }
  .navlinks a:hover, .navlinks a:focus-visible{ color:var(--ink); }
  .navcta{ display:flex; align-items:center; gap:14px; }
  .langtoggle{
    display:flex; border:1px solid var(--line-strong); font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.05em;
  }
  .langtoggle button{
    background:transparent; border:none; padding:8px 12px; cursor:pointer; color:var(--ink-soft); font-family:'IBM Plex Mono'; font-size:11px;
  }
  .langtoggle button.active{ background:var(--ink); color:var(--paper); }
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:11px 22px; border-radius:1px;
    font-size:12.5px; letter-spacing:0.04em;
    border:1px solid var(--ink); color:var(--paper); background:var(--ink);
    transition:all .22s ease; cursor:pointer; font-family:'Inter'; font-weight:500;
  }
  .btn:hover, .btn:focus-visible{ background:var(--paper); color:var(--ink); }
  .btn.ghost{ background:transparent; color:var(--ink); border-color:var(--line-strong); }
  .btn.ghost:hover{ border-color:var(--ink); }
  .navphone{ display:none; }
  @media(min-width:860px){ .navphone{ display:inline-flex; } }
  @media(max-width:860px){ .navlinks{ display:none; } }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible{ outline:2px solid var(--stamp); outline-offset:3px; }

  /* ---------- hero ---------- */
  .hero{
    position:relative;
    padding:88px 0 60px;
    border-bottom:1px solid var(--line);
  }
  .hero-grid{ display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; }
  @media(max-width:920px){ .hero-grid{ grid-template-columns:1fr; } }
  .eyebrow{
    font-family:'IBM Plex Mono'; font-size:11.5px; letter-spacing:0.14em; color:var(--stamp);
    display:flex; align-items:center; gap:10px; margin-bottom:20px; text-transform:uppercase;
  }
  .eyebrow::before{ content:""; width:24px; height:1px; background:var(--stamp); }
  .hero h1{ font-size:clamp(38px,5.4vw,62px); }
  .hero p.lead{
    margin-top:22px; max-width:460px; color:var(--ink-soft); font-size:16px; line-height:1.65;
  }
  .hero-actions{ display:flex; gap:12px; margin-top:32px; flex-wrap:wrap; }

  /* ---------- route map (hero signature) ---------- */
  .routemap{
    position:relative; aspect-ratio:1/0.72;
    border:1px solid var(--line);
    background:var(--panel);
  }
  .routemap svg{ position:absolute; inset:0; width:100%; height:100%; }
  .routemap .caption{
    position:absolute; left:16px; bottom:12px; right:16px;
    display:flex; justify-content:space-between;
    font-family:'IBM Plex Mono'; font-size:10.5px; color:var(--ink-soft); letter-spacing:0.04em;
  }

  /* ---------- photo band ---------- */
  .photoband{ position:relative; height:260px; overflow:hidden; border-bottom:1px solid var(--line); }
  .photoband img{ width:100%; height:100%; object-fit:cover; }
  .photoband::after{
    content:""; position:absolute; inset:0;
    background:linear-gradient(90deg, rgba(25,26,24,0.72) 0%, rgba(25,26,24,0.32) 45%, rgba(25,26,24,0.06) 100%);
  }
  .photoband .pb-caption{
    position:absolute; left:28px; bottom:22px; z-index:2; max-width:520px;
    color:#F1EEE6;
  }
  .photoband .pb-caption .kicker{ color:#D9A9A6; margin-bottom:8px; }
  .photoband .pb-caption h2{ font-size:clamp(22px,3vw,30px); color:#F1EEE6; }

  /* ---------- ledger stats ---------- */
  .stats{ border-bottom:1px solid var(--line); }
  .stats .wrap{ display:grid; grid-template-columns:repeat(4,1fr); }
  @media(max-width:760px){ .stats .wrap{ grid-template-columns:repeat(2,1fr); } }
  .stat{ padding:30px 24px; border-right:1px solid var(--line); border-top:1px solid var(--line); }
  .stat:nth-child(4){ border-right:none; }
  @media(max-width:760px){ .stat:nth-child(2n){ border-right:none; } }
  .stat .num{ font-family:'Fraunces'; font-weight:600; font-size:32px; }
  .stat .lbl{ font-family:'IBM Plex Mono'; font-size:10.5px; letter-spacing:0.05em; color:var(--ink-soft); text-transform:uppercase; margin-top:6px; }

  /* ---------- section shell ---------- */
  section{ padding:88px 0; }
  .section-head{ max-width:600px; margin-bottom:48px; }
  .kicker{
    font-family:'IBM Plex Mono'; font-size:11.5px; letter-spacing:0.14em; color:var(--stamp);
    text-transform:uppercase; margin-bottom:12px; display:block;
  }
  .section-head h2{ font-size:clamp(28px,3.6vw,40px); }
  .section-head p{ color:var(--ink-soft); margin-top:14px; font-size:15px; line-height:1.6; }

  /* ---------- station header ---------- */
  .station-head{
    display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:12px;
    border-bottom:1px solid var(--line-strong); padding-bottom:18px; margin-bottom:8px;
  }
  .station-head .st-name{ font-family:'Fraunces'; font-weight:600; font-size:25px; }
  .station-head .st-code{ font-family:'IBM Plex Mono'; font-size:12px; color:var(--ink-soft); letter-spacing:0.05em; }

  /* ---------- manifest rows ---------- */
  .manifest{ border-top:1px solid var(--line); }
  .row{
    display:grid; grid-template-columns:96px 1fr 150px;
    align-items:center; gap:18px;
    border-bottom:1px solid var(--line);
    padding:22px 4px;
    transition:background .2s ease;
  }
  .row:hover{ background:var(--stamp-soft); }
  @media(max-width:700px){ .row{ grid-template-columns:1fr; gap:8px; padding:20px 4px;} .row .code, .row .time{ display:none; } }
  .row .code{ font-family:'IBM Plex Mono'; color:var(--ink-faint); font-size:12px; letter-spacing:0.03em; }
  .row .info h3{ font-family:'Fraunces'; font-weight:600; font-size:19px; }
  .row .info p{ color:var(--ink-soft); font-size:13.8px; margin-top:5px; max-width:480px; line-height:1.55; }
  .row .time{ font-family:'IBM Plex Mono'; font-size:11.5px; color:var(--ink-soft); text-align:right; letter-spacing:0.03em; }

  /* ---------- process ---------- */
  .process-list{ display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  @media(max-width:820px){ .process-list{ grid-template-columns:repeat(2,1fr); } }
  .pstep{ padding:28px 24px 32px; border-right:1px solid var(--line); border-bottom:1px solid var(--line); }
  .pstep .pnum{ font-family:'IBM Plex Mono'; color:var(--stamp); font-size:11.5px; }
  .pstep h3{ font-family:'Fraunces'; font-size:20px; font-weight:600; margin-top:12px; }
  .pstep p{ color:var(--ink-soft); font-size:13.5px; margin-top:9px; line-height:1.55; }

  /* ---------- gallery (real photography) ---------- */
  .gallery{ display:grid; grid-template-columns:1.3fr 1fr 1fr; grid-template-rows:220px 220px; gap:14px; }
  @media(max-width:820px){ .gallery{ grid-template-columns:1fr 1fr; grid-template-rows:180px 180px 180px; } }
  .gpanel{ position:relative; overflow:hidden; border:1px solid var(--line); background:var(--panel); }
  .gpanel.big{ grid-row:span 2; }
  @media(max-width:820px){ .gpanel.big{ grid-row:span 1; grid-column:span 2; height:220px; } }
  .gpanel img{ width:100%; height:100%; object-fit:cover; }
  .gpanel .cap{
    position:absolute; left:14px; bottom:12px; font-family:'IBM Plex Mono'; font-size:10.5px;
    letter-spacing:0.08em; color:#F1EEE6; text-transform:uppercase; text-shadow:0 1px 6px rgba(0,0,0,0.5);
  }

  /* ---------- fleet ---------- */
  .fleet{ display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  @media(max-width:820px){ .fleet{ grid-template-columns:repeat(2,1fr); } }
  .fcard{ padding:28px 20px; text-align:center; border-right:1px solid var(--line); border-bottom:1px solid var(--line); }
  .fcard svg{ width:64px; height:30px; margin:0 auto 16px; }
  .fcard h3{ font-family:'Fraunces'; font-size:16.5px; font-weight:600; }
  .fcard p{ color:var(--ink-soft); font-size:12px; margin-top:5px; }

  /* ---------- quote ---------- */
  .quote-strip{ position:relative; background:var(--ink); color:var(--paper); border-top:1px solid var(--line); border-bottom:1px solid var(--line); overflow:hidden; }
  .quote-strip .qbg{ position:absolute; inset:0; }
  .quote-strip .qbg img{ width:100%; height:100%; object-fit:cover; opacity:0.22; }
  .quote-strip .wrap{ position:relative; z-index:1; }
  .quote-strip blockquote{
    font-family:'Fraunces'; font-weight:500; font-size:clamp(22px,2.8vw,30px);
    max-width:780px; line-height:1.3;
  }
  .quote-strip cite{ display:block; margin-top:18px; font-style:normal; font-family:'IBM Plex Mono'; font-size:11.5px; color:#C9CAC2; letter-spacing:0.04em; }

  /* ---------- contact ---------- */
  .ticket{
    border:1px solid var(--line-strong); background:var(--panel);
    display:grid; grid-template-columns:1.15fr 1px 1fr;
  }
  @media(max-width:820px){ .ticket{ grid-template-columns:1fr; } .ticket .perf{ display:none; } }
  .ticket .perf{ background:repeating-linear-gradient(to bottom, var(--line-strong) 0 8px, transparent 8px 16px); }
  .ticket-left{ padding:42px 40px; }
  .ticket-right{ padding:42px 40px; background:var(--panel-2); }
  .ticket h3{ font-size:23px; margin-bottom:22px; }
  .field{ margin-bottom:18px; }
  .field label{ display:block; font-family:'IBM Plex Mono'; font-size:10px; letter-spacing:0.07em; color:var(--ink-soft); text-transform:uppercase; margin-bottom:7px; }
  .field input, .field select, .field textarea{
    width:100%; background:transparent; border:none; border-bottom:1px solid var(--line-strong);
    color:var(--ink); font-family:'Inter'; font-size:14.5px; padding:9px 2px; outline:none;
    transition:border-color .2s ease;
  }
  .field input:focus, .field select:focus, .field textarea:focus{ border-color:var(--stamp); }
  .field select option{ background:var(--paper); }
  .ticket-right .contactline{ display:flex; align-items:flex-start; gap:14px; margin-bottom:24px; }
  .ticket-right .contactline .ico{ width:32px; height:32px; border:1px solid var(--stamp); border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; color:var(--stamp); font-size:13px; }
  .ticket-right .contactline .lbl{ font-family:'IBM Plex Mono'; font-size:10px; color:var(--ink-soft); letter-spacing:0.05em; text-transform:uppercase; }
  .ticket-right .contactline .val{ font-family:'Fraunces'; font-size:20px; font-weight:600; margin-top:2px; }
  .ticket-right .contactline .sub{ font-size:12px; color:var(--ink-soft); margin-top:2px; }
  .stampmark{
    margin-top:28px; display:inline-flex; align-items:center; gap:8px;
    border:1px solid var(--stamp); color:var(--stamp); padding:6px 12px;
    font-family:'IBM Plex Mono'; font-size:10.5px; letter-spacing:0.08em; text-transform:uppercase;
    transform:rotate(-2deg);
  }

  footer{ border-top:1px solid var(--line); padding:32px 0; }
  footer .wrap{ display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px; }
  footer .fmono{ font-family:'IBM Plex Mono'; font-size:10.5px; color:var(--ink-soft); letter-spacing:0.04em; }
</style>
</head>
